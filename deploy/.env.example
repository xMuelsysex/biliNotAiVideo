# Required runtime configuration for local compose.
# Fill values before `docker compose -f deploy/docker-compose.yml up`.
# Do not put production credentials or default passwords into source control.

# PostgreSQL
POSTGRES_DB=bili_ai
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=5432

# Backend service settings (prefix BILI_AI_)
BILI_AI_DATABASE_URL=
BILI_AI_REDIS_URL=redis://redis:6379/0
BILI_AI_ALLOWED_EXTENSION_ORIGINS=
BILI_AI_QUERY_PER_MINUTE_LIMIT=60
BILI_AI_MEDIA_TEMP_ROOT=/tmp/bili-ai-media
BILI_AI_MEDIA_WORKSPACE_MAX_BYTES=268435456
BILI_AI_MEDIA_COMMAND_TIMEOUT_SECONDS=300
BILI_AI_ANALYSIS_TASK_TIMEOUT_SECONDS=900
BILI_AI_BCUT_API_BASE=
BILI_AI_AI_API_BASE=
BILI_AI_AI_API_KEY=
BILI_AI_AI_MODEL=
BILI_AI_BILIBILI_COOKIE=

# Default 4-vCPU / 8-GiB public-beta resource budget.
# Two worker replicas provide two concurrent analysis slots.
POSTGRES_CPUS=0.75
POSTGRES_MEMORY=2g
REDIS_CPUS=0.25
REDIS_MEMORY=512m
MIGRATE_CPUS=0.5
MIGRATE_MEMORY=512m
API_CPUS=0.75
API_MEMORY=1g
DISPATCHER_CPUS=0.25
DISPATCHER_MEMORY=256m
WORKER_REPLICAS=2
WORKER_CPUS=0.75
WORKER_MEMORY=1536m
CADDY_CPUS=0.25
CADDY_MEMORY=256m

# Performance-only values. Use an isolated database ending in `_perf`, seed it,
# then register a fresh installation token. Raise the query limit in that
# isolated stack so the benchmark measures cached API performance.
PERF_DATABASE_URL=
PERF_INSTALLATION_TOKEN=
PERF_QUERY_PER_MINUTE_LIMIT=1000000

# TLS endpoint and certificates used by Caddy and the performance protocol
CADDY_SITE_ADDRESS=https://localhost
TLS_PORT=443
TLS_CERT_PATH=./certs/localhost.pem
TLS_KEY_PATH=./certs/localhost-key.pem
PERF_CA_CERT=./certs/ca.pem

# Extension package origin baked into the browser build
VITE_API_ORIGIN=https://localhost
